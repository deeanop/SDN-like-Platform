;pressing e in GRUB menu for kernel boot options editing and modifying starting line (vmlinuz) by adding init=/bin/bash
mount -o remount,rw / ;remounting the file system with write permissions in vncviewer
passwd root ;entering the new password for root user
sync
exec /sbin/init ;writing the modifications on disk and starting the VM
ip link show ;viewing the physical and virtual interfaces
ip link set ens4 up ;activating the ens4 interface
dhclient -v ens4 ;requesting an IP address through DHCP
apt update && apt install -y build-essential libpcap-dev libpcre3-dev libdumbnet-dev bison flex zlib1g-dev libdaq-dev libluajit-5.1-dev libssl-dev libnghttp2-dev ;installing the compiler and development libraries
wget https://www.snort.org/downloads/snort/snort-2.9.20.tar.gz ;installing snort
tar -xvzf snort-2.9.20.tar.gz ;extracting the archive
cd snort-2.9.20
./configure ;running the standard installing sequence
make ;compiling
make install ;installing the app
ip a ;founding the name of interface connected to the network segment that will be listen
nano /etc/snort/snort.conf ;configuring the config paths: RULE_PATH, SO_RULE_PATH and PREPROC_RULE_PATH
;creating the missing files with touch command
snort -T -c /etc/snort/snort.conf -i ens4 ;testing the config
snort -A console -q-c /etc/snort/snort.conf -i ens4 ;starting snort for live capture
